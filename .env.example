# Copy to .env and edit. Every value below is optional; the defaults shown are
# what the code uses when the variable is absent.

# ---------------------------------------------------------------- Temporal
# Local dev server defaults. Leave as is for a local demo.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=po-approval

# --------------------------------------------------- Temporal Cloud (optional)
# To use Temporal Cloud instead, set the address to your namespace's gRPC
# endpoint and the namespace to its fully qualified "namespace.account_id"
# form, then pick ONE auth method below. TLS is enabled automatically for any
# *.tmprl.cloud address or whenever a credential is set; TEMPORAL_TLS forces
# it on or off explicitly.
#
# TEMPORAL_ADDRESS=your-namespace.acct.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=your-namespace.acct
#
# Option 1, API key:
# TEMPORAL_API_KEY=your-api-key
#
# Option 2, mTLS client certificate:
# TEMPORAL_TLS_CLIENT_CERT_PATH=/path/to/client.pem
# TEMPORAL_TLS_CLIENT_KEY_PATH=/path/to/client.key
#
# Rarely needed:
# TEMPORAL_TLS=true
# TEMPORAL_TLS_SERVER_CA_PATH=/path/to/ca.pem
# TEMPORAL_TLS_SERVER_NAME=override.sni.name
# TEMPORAL_UI_URL=https://cloud.temporal.io

# ----------------------------------------------------------- Amazon Bedrock
# Credentials come from the standard AWS chain (env vars, profile, SSO, role).
# Alternatively set a Bedrock API key and nothing else. It is read from the
# environment, not from this file, and it takes precedence over the chain above
# for Bedrock calls only, so a stale one fails this demo while the rest of the
# AWS CLI keeps working. Short term keys expire within 12 hours.
#   export AWS_BEARER_TOKEN_BEDROCK=...
BEDROCK_REGION=us-east-1

# The intended target model for this demo is Claude Haiku 4.5:
#   BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# On accounts that have not submitted the Bedrock "Anthropic use case details"
# form, every Anthropic model returns ResourceNotFoundException. The default
# below is a model that works without that form. See the README section
# "Bedrock model access".
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.0

# start_to_close_timeout for an agent's model turn, in seconds. This also
# bounds how long Temporal takes to notice a worker died mid call: a crashed
# worker reports nothing, so an orphaned activity cannot be rescheduled until
# its timeout expires. Model turns run 1.5 to 6 seconds in practice. Set this
# to 15 when you plan to demo a worker crash by hand, or the workflow appears
# to hang for a minute. scripts/crash_demo.sh sets it for you.
AGENT_ACTIVITY_TIMEOUT_SECONDS=60

# Per agent model overrides. Each falls back to BEDROCK_MODEL_ID when unset,
# so the demo runs on one model by default. Set them to put a cheaper model on
# the mechanical agents and a stronger one on the supervisor; the UI shows
# which model answered for each agent.
# BEDROCK_MODEL_EXTRACTION=us.amazon.nova-lite-v1:0
# BEDROCK_MODEL_VENDOR_RISK=us.amazon.nova-pro-v1:0
# BEDROCK_MODEL_POLICY=us.amazon.nova-pro-v1:0
# BEDROCK_MODEL_DUPLICATE=us.amazon.nova-lite-v1:0
# BEDROCK_MODEL_SUPERVISOR=us.amazon.nova-pro-v1:0

# ------------------------------------------------------------ Spend policy
# Above this amount a PO needs a human decision.
PO_APPROVAL_THRESHOLD=10000
# Above this amount a PO is rejected outright with no human override.
PO_HARD_BLOCK_THRESHOLD=250000
PO_BLOCKED_VENDORS=Acme Shell Corp,Unverified Holdings LLC

# ------------------------------------------------------- Simulated ERP step
# Default number of leading ERP attempts that fail. The UI scenarios override
# this per run, so leave it at 0 unless you want every run to retry.
ERP_SEEDED_FAILURES=0
# Temporal RetryPolicy maximum_attempts for the ERP activity.
ERP_MAX_ATTEMPTS=5

# ---------------------------------------------------- Human in the loop
APPROVAL_TIMEOUT_SECONDS=900

# ------------------------------------------------------------------- API
API_HOST=127.0.0.1
API_PORT=8000
